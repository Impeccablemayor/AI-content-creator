# Groq uses the existing OpenAI-compatible chat completions transport.
AI__Provider=Groq
AI__Model=openai/gpt-oss-20b
AI__BaseUrl=https://api.groq.com/openai/v1/
AI__ApiKey=
AI__TimeoutSeconds=45

# Optional LinkedIn OAuth configuration. Copy these keys into the ignored
# repository-root .env file and fill in values from your LinkedIn developer app.
# The redirect URI must exactly match the URL registered in that app.
# For the API's default HTTP launch profile:
# Social__LinkedIn__ClientId=
# Social__LinkedIn__ClientSecret=
# Social__LinkedIn__RedirectUri=http://localhost:5025/api/v1/social/linkedin/callback
# Social__LinkedIn__Scopes__0=openid
# Social__LinkedIn__Scopes__1=profile
# Social__LinkedIn__Scopes__2=email
# Add only scopes enabled for the LinkedIn app. Publishing also needs:
# Social__LinkedIn__Scopes__3=w_member_social

# Switch to OpenRouter by replacing the provider, model, and base URL:
# AI__Provider=OpenRouter
# AI__Model=<OpenRouter model ID>
# AI__BaseUrl=https://openrouter.ai/api/v1/
# AI__ApiKey=

# Existing provider alternatives:
# AI__Provider=OpenAI
# AI__Model=gpt-4o-mini
# AI__BaseUrl=https://api.openai.com/v1/
# AI__Provider=Gemini
# AI__Model=gemini-3.8-flash
# AI__ApiKey=