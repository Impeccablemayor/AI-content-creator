{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ContentQuality": {
    "PassThreshold": 70,
    "RepetitionSimilarityThreshold": 0.75
  },
  "LearningLoop": {
    "LookbackDays": 90,
    "MinimumMeasuredPosts": 5,
    "MinimumPostsPerGroup": 2,
    "MinimumEngagementRateGap": 0.25
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 20,
    "AuthenticationWindow": "00:01:00",
    "KeyPrefix": "mayorx:ratelimit"
  },
  "RequestSizeLimit": {
    "MaxRequestBodySizeInBytes": 8388608
  },
  "Metrics": {
    "Enabled": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
