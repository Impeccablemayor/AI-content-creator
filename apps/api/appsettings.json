{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ContentQuality": {
    "PassThreshold": 70,
    "RepetitionSimilarityThreshold": 0.75
  },
  "LearningLoop": {
    "LookbackDays": 90,
    "MinimumMeasuredPosts": 5,
    "MinimumPostsPerGroup": 2,
    "MinimumEngagementRateGap": 0.25
  },
  "AllowedHosts": "*"
}
