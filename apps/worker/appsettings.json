{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scheduling": {
    "PollIntervalSeconds": 30,
    "BatchSize": 25,
    "ClaimExpiryMinutes": 15
  },
  "AnalyticsSync": {
    "PollIntervalSeconds": 300,
    "BatchSize": 10,
    "ResyncIntervalHours": 24
  },
  "Social": {
    "LinkedIn": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "",
      "Scopes": [ "openid", "profile", "w_member_social" ],
      "PublishEndpoint": "https://api.linkedin.com/v2/ugcPosts",
      "MetricsEndpoint": "https://api.linkedin.com/rest/memberCreatorPostAnalytics"
    },
    "X": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "",
      "Scopes": [ "tweet.read", "tweet.write", "users.read", "offline.access" ],
      "PublishEndpoint": "https://api.twitter.com/2/tweets",
      "MetricsEndpoint": "https://api.twitter.com/2/tweets"
    }
  }
}
